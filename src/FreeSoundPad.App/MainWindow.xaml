<Window x:Class="FreeSoundPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FreeSoundPad.App.Views"
        xmlns:controls="clr-namespace:FreeSoundPad.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FreeSoundPad"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStyle="None" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="#1C2534" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- ============================ TITLE BAR ============================ -->
            <Grid Grid.Row="0" Background="#0A0E15" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource LineBrush}" />

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55F0C5" Offset="0" />
                                <GradientStop Color="#1CAE87" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#03241B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock FontSize="14.5" FontWeight="SemiBold" Text="FreeSound" />
                        <TextBlock FontSize="14.5" FontWeight="SemiBold" Text="Pad" Foreground="{StaticResource MintBrush}" />
                    </StackPanel>
                    <Border CornerRadius="99" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                            Padding="7,4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="1.0 · RELEASE" FontFamily="{StaticResource MonoFont}" FontSize="8" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Background="#0F1622" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabRadio}" GroupName="TopTabs"
                                     IsChecked="{Binding IsSoundsTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Звуки" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabRadio}" GroupName="TopTabs"
                                     IsChecked="{Binding IsBrowserTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Браузер" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Height="38" Padding="10,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Command="{Binding OpenSettingsCommand}" ToolTip="Выходное устройство">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource Line2Brush}"
                                        BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MintBorderBrush}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource MintSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ВЫХОД" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding OutputDeviceName}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Content="&#xE7F6;" Command="{Binding ToggleMonitorCommand}" ToolTip="Мониторинг в наушники">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MonitorEnabled}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                        <Setter Property="Background" Value="{StaticResource MintSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">                        <Button Style="{StaticResource TitleBarIconButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Свернуть" />
                        <Button Style="{StaticResource TitleBarIconButton}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Развернуть" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE711;" Click="OnCloseClick" ToolTip="Закрыть" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================ WORKSPACE ============================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="MixerColumn" Width="{Binding MixerVisible, Converter={StaticResource MixerWidth}}" />
                </Grid.ColumnDefinitions>

                <!-- rail -->
                <Border Grid.Column="0" Background="#080B11" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center">
                            <RadioButton Style="{StaticResource RailRadio}" GroupName="RailNav" Content="&#xE80A;"
                                         IsChecked="{Binding IsSoundsTab, Mode=TwoWay}" ToolTip="Звуки" Margin="0,0,0,6" />
                            <RadioButton Style="{StaticResource RailRadio}" GroupName="RailNav" Content="&#xE774;"
                                         IsChecked="{Binding IsBrowserTab, Mode=TwoWay}" ToolTip="Браузер" Margin="0,0,0,6" />
                            <Border Width="24" Height="1" Background="{StaticResource LineBrush}" Margin="0,7,0,7" />
                            <Button Width="42" Height="42" Content="&#xE9E9;" Command="{Binding ToggleMixerCommand}"
                                    ToolTip="Боковое меню / микшер">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MixerVisible}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                                <Setter Property="Background" Value="{StaticResource MintSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="42" Height="42" Content="&#xE8B7;"
                                    Command="{Binding OpenSoundsFolderCommand}" ToolTip="Папка библиотеки" />
                            <Button Width="42" Height="42" Content="&#xE8B9;" Command="{Binding ToggleOverlayCommand}"
                                    ToolTip="Оверлей поверх окон">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverlayVisible}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                                <Setter Property="Background" Value="{StaticResource MintSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Button Style="{StaticResource IconButton}" Width="42" Height="42" Content="&#xE713;"
                                Command="{Binding OpenSettingsCommand}" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                ToolTip="Настройки" />
                    </Grid>
                </Border>

                <!-- content -->
                <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
                    <views:SoundboardView Visibility="{Binding IsSoundsTab, Converter={StaticResource BoolVisibility}}" />
                    <views:BrowserView Visibility="{Binding IsBrowserTab, Converter={StaticResource BoolVisibility}}" />
                </Grid>

                <!-- side panel -->
                <Border Grid.Column="2" Background="#0A0E15" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding MixerVisible, Converter={StaticResource BoolVisibility}}">
                    <Grid>
                        <views:MixerView Visibility="{Binding IsSoundsTab, Converter={StaticResource BoolVisibility}}" />
                        <views:CapturePanel Visibility="{Binding IsBrowserTab, Converter={StaticResource BoolVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================ STATUS BAR ============================ -->
            <Border Grid.Row="2" Background="#080B11" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource StopButton}" Command="{Binding StopAllCommand}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{StaticResource RedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="СТОП ВСЁ" VerticalAlignment="Center" />
                            <TextBlock Text="Ctrl Alt X" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                       Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="ВЫХОД" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <controls:VuMeter Width="220" Height="6" Segments="18" Level="{Binding OutputLevel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OutputLevel, StringFormat={}{0:F0}%}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="9" Foreground="{StaticResource Muted2Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource ChipCheckBox}" IsChecked="{Binding MicPassthrough, Mode=TwoWay}"
                                  Margin="0,0,6,0" ToolTip="Подмешивать реальный микрофон в эфир">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Микрофон в эфир" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ChipCheckBox}" IsChecked="{Binding MonitorEnabled, Mode=TwoWay}"
                                  Margin="0,0,10,0" ToolTip="Слышать пады и браузер в наушниках">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Наушники" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{Binding FooterMeta}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
