<Window x:Class="FreeSoundPad.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeSoundPad Overlay"
        SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="OverlayPad" TargetType="Button">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{Binding PadBackground}" BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayPadLarge" TargetType="Button" BasedOn="{StaticResource OverlayPad}">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="62" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>

        <Style x:Key="OverlayIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="OverlayAction" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource Line2Brush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="16" Background="#F20A0E15" BorderBrush="#3D3FE0B0"
            BorderThickness="1" Padding="12,9,12,11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid MouseLeftButtonDown="OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55F0C5" Offset="0" />
                                <GradientStop Color="#1CAE87" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#03241B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FreeSoundPad" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <Border CornerRadius="99" Background="{StaticResource Panel3Brush}" Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="ОВЕРЛЕЙ" FontSize="7" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleOverlaySizeCommand}" ToolTip="Размер оверлея" Margin="0,0,2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OverlayIconButton}">
                                <Setter Property="Content" Value="&#xE740;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverlayCompact}" Value="True">
                                        <Setter Property="Content" Value="&#xE73F;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButton}" Content="&#xE71A;" Command="{Binding StopAllCommand}"
                            Foreground="{StaticResource RedBrush}" ToolTip="Стоп всё" Margin="0,0,2,0" />
                    <Button Command="{Binding ToggleMicCommand}" ToolTip="Микрофон в эфир" Margin="0,0,2,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OverlayIconButton}">
                                <Setter Property="Content" Value="&#xE720;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MicPassthrough}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource OverlayIconButton}" Content="&#xE8A7;" Command="{Binding ShowWindowCommand}"
                            ToolTip="Открыть главное окно" Margin="0,0,2,0" />
                    <Button Style="{StaticResource OverlayIconButton}" Content="&#xE711;" Command="{Binding ToggleOverlayCommand}"
                            ToolTip="Скрыть оверлей" />
                </StackPanel>
            </Grid>

            <!-- COMPACT -->
            <StackPanel Visibility="{Binding OverlayCompact, Converter={StaticResource BoolVisibility}}">
                <ItemsControl ItemsSource="{Binding QuickPads}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource OverlayPad}" Command="{Binding PlayCommand}" ToolTip="{Binding Title}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ShortKey}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="8" Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom" MaxWidth="46" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- LARGE -->
            <StackPanel Visibility="{Binding OverlayCompact, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding OutputDeviceName}" FontSize="8.5" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="330" />
                            <TextBlock Text="  ·  " FontSize="8.5" Foreground="{StaticResource Muted2Brush}" />
                            <TextBlock FontSize="8.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="МИКРОФОН В ЭФИРЕ" />
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MicPassthrough}" Value="False">
                                                <Setter Property="Text" Value="МИКРОФОН ВЫКЛ" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="  ·  " FontSize="8.5" Foreground="{StaticResource Muted2Brush}" />
                            <TextBlock FontSize="8.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="WEB В МИКШЕРЕ" />
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BrowserSend}" Value="False">
                                                <Setter Property="Text" Value="WEB ВЫКЛ" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,9,0,0">
                    <Button Style="{StaticResource OverlayAction}" Command="{Binding StopAllCommand}" Content="Стоп всё" />
                    <Button Command="{Binding ToggleBrowserMuteCommand}" Margin="0,0,5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OverlayAction}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrowserMuted}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Стоп звук браузера" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BrowserMuted}" Value="True">
                                            <Setter Property="Text" Value="Вернуть звук браузера" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding ToggleBrowserSendCommand}" Margin="0,0,5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OverlayAction}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrowserSend}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Браузер в микрофон" />
                    </Button>
                    <Button Command="{Binding ToggleMicCommand}" Margin="0,0,5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OverlayAction}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MicPassthrough}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Микрофон в эфир" />
                    </Button>
                    <Button Command="{Binding ToggleMonitorCommand}" Margin="0,0,5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OverlayAction}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MonitorEnabled}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Мониторинг" />
                    </Button>
                    <Button Style="{StaticResource OverlayAction}" Command="{Binding OpenSettingsCommand}" Content="Настройки" />
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding QuickPads}" Margin="0,10,0,0" MaxWidth="740">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource OverlayPadLarge}" Command="{Binding PlayCommand}" ToolTip="{Binding Title}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ShortKey}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="8.5" Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom" MaxWidth="58" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
