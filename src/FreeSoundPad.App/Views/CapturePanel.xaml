<UserControl x:Class="FreeSoundPad.App.Views.CapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeSoundPad.App.Controls">
    <Grid Margin="16,15,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="БРАУЗЕР → МИКШЕР" Style="{StaticResource SectionLabel}" Margin="0,0,0,13" />

        <!-- capture status -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13,12,13,12" Margin="0,0,0,13">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A3FE0B0" Offset="0" />
                    <GradientStop Color="#05101622" Offset="0.7" />
                    <GradientStop Color="#FF101622" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#333FE0B0" />
            </Border.BorderBrush>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Muted2Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrowserCaptureActive}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding BrowserStatusText}" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding BrowserCaptureDetail}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14" />
                <controls:VuMeter Height="9" Segments="18" Level="{Binding WebLevel}" Margin="0,11,0,0" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="{Binding WebLevel, StringFormat={}уровень {0:F0}%}" Style="{StaticResource MonoText}" FontSize="9" />
                    <TextBlock Text="48 kHz · stereo" Style="{StaticResource MonoText}" FontSize="9" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- toggles -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10,12,10" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Отправлять в микрофон" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="звук сайта идёт в кабель" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding BrowserSend, Mode=TwoWay}"
                          IsEnabled="{Binding BrowserCaptureEnabled}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10,12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Слышать локально" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock Text="захват сайта в наушники мониторинга" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding BrowserMonitor, Mode=TwoWay}"
                          IsEnabled="{Binding CanMonitor}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- route -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10,12,11" Margin="0,0,0,13">
            <StackPanel>
                <TextBlock Text="МАРШРУТ СИГНАЛА" Style="{StaticResource SectionLabel}" FontSize="8" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Браузер" FontSize="9.5" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                    <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource Line2Brush}" Margin="7,0" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="{StaticResource MintSoftBrush}" BorderBrush="{StaticResource MintBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="5,2">
                        <TextBlock Text="WEB" FontFamily="{StaticResource MonoFont}" FontSize="8" FontWeight="Bold"
                                   Foreground="{StaticResource MintBrush}" />
                    </Border>
                    <Rectangle Grid.Column="3" Height="1" Fill="{StaticResource Line2Brush}" Margin="7,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Микрофон" FontSize="9.5" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Звук сайта смешивается с падами и голосом и уходит в выбранный выход."
                           FontSize="9" Foreground="{StaticResource Muted2Brush}" TextWrapping="Wrap" Margin="0,9,0,0" />
            </StackPanel>
        </Border>

        <!-- info -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="12,4,12,4" Margin="0,0,0,10">
            <StackPanel>
                <Grid Height="27">
                    <TextBlock Text="Источник" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="только этот браузер" FontSize="10.5" Foreground="{StaticResource Text2Brush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource HairLine}" />
                <Grid Height="27">
                    <TextBlock Text="Процесс" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BrowserProcessText}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource HairLine}" />
                <Grid Height="27">
                    <TextBlock Text="Задержка" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="≈ 65 мс" FontSize="10.5" Foreground="{StaticResource Text2Brush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource HairLine}" />
                <Grid Height="27">
                    <TextBlock Text="Буфер" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="30 мс" FontSize="10.5" Foreground="{StaticResource Text2Brush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Button Grid.Row="6" Style="{StaticResource SecondaryButton}" Command="{Binding RestartBrowserCaptureCommand}"
                VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Перезапустить захват" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- excluded -->
        <Border Grid.Row="8" Style="{StaticResource Card}" Padding="12,10,12,11" Background="#0C1017">
            <StackPanel>
                <TextBlock Text="НЕ ПОПАДАЕТ В ЗАХВАТ" Style="{StaticResource SectionLabel}" FontSize="8" />
                <StackPanel Margin="0,7,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="#99FF5C6C" VerticalAlignment="Center" />
                        <TextBlock Text="системные звуки и уведомления" FontSize="9.5" Foreground="{StaticResource Muted2Brush}" Margin="7,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="#99FF5C6C" VerticalAlignment="Center" />
                        <TextBlock Text="другие приложения и игры" FontSize="9.5" Foreground="{StaticResource Muted2Brush}" Margin="7,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="#99FF5C6C" VerticalAlignment="Center" />
                        <TextBlock Text="голос собеседников из чата" FontSize="9.5" Foreground="{StaticResource Muted2Brush}" Margin="7,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
