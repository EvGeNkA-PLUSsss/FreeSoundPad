<UserControl x:Class="FreeSoundPad.App.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeSoundPad.App.Controls">
    <Grid Margin="16,15,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,13">
            <TextBlock Text="МИКШЕР" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            <Button Content="Сброс" Style="{StaticResource GhostButton}" Height="24" Padding="9,0" FontSize="10"
                    HorizontalAlignment="Right" Command="{Binding ResetMixerCommand}" />
        </Grid>

        <!-- now playing -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="11,10,11,11" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#143FE0B0" Offset="0" />
                    <GradientStop Color="#03101622" Offset="0.65" />
                    <GradientStop Color="#FF101622" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#2E3FE0B0" />
            </Border.BorderBrush>
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="СЕЙЧАС В ЭФИРЕ" FontSize="8" FontWeight="Bold" Foreground="#CC3FE0B0" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding NowPlayingTime}" HorizontalAlignment="Right" Style="{StaticResource MonoText}"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding NowPlayingTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding NowPlayingProgress}" Maximum="100"
                             Margin="0,8,0,0" Foreground="{StaticResource MintBrush}" Background="#14FFFFFF" />
                <TextBlock Text="{Binding NowPlayingMeta}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <!-- channel faders -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,9,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="MIC" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="микрофон" FontSize="8" Foreground="{StaticResource Muted2Brush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,9,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource VerticalFader}" Value="{Binding MicGain, Mode=TwoWay}" />
                        <controls:VuMeter Grid.Column="1" Width="6" Margin="4,0,0,0" IsVertical="True" Segments="16"
                                          Level="{Binding MicLevel}" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding MicGain, StringFormat={}{0:F0}%}" Style="{StaticResource MonoText}"
                               Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,9,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="PAD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="звуки" FontSize="8" Foreground="{StaticResource Muted2Brush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,9,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource VerticalFader}" Value="{Binding PadGain, Mode=TwoWay}" />
                        <controls:VuMeter Grid.Column="1" Width="6" Margin="4,0,0,0" IsVertical="True" Segments="16"
                                          Level="{Binding PadLevel}" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding PadGain, StringFormat={}{0:F0}%}" Style="{StaticResource MonoText}"
                               Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="8,9,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="WEB" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="браузер" FontSize="8" Foreground="{StaticResource Muted2Brush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,9,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource VerticalFader}" Value="{Binding WebGain, Mode=TwoWay}" />
                        <controls:VuMeter Grid.Column="1" Width="6" Margin="4,0,0,0" IsVertical="True" Segments="16"
                                          Level="{Binding WebLevel}" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding WebGain, StringFormat={}{0:F0}%}" Style="{StaticResource MonoText}"
                               Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- switches -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <Grid Margin="0,0,0,9">
                <TextBlock Text="Микрофон в эфир" FontSize="11" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding MicPassthrough, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid>
                <TextBlock Text="Мониторинг в наушники" FontSize="11" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding MonitorEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding CanMonitor}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- output card -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="11,10,11,11">
            <StackPanel>
                <TextBlock Text="ВЫХОД" Style="{StaticResource SectionLabel}" />
                <Border Margin="0,6,0,0" CornerRadius="5" Padding="6,3" Background="#2B2410" BorderBrush="#7A6520" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputIsCable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ · без виртуального кабеля"
                               FontSize="9" FontWeight="SemiBold" Foreground="#F2C14E" TextWrapping="Wrap" />
                </Border>
                <Border Margin="0,6,0,0" CornerRadius="5" Padding="6,3" Background="#2B1010" BorderBrush="#7A2020" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputEndpointSilent}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="CABLE НЕ ПЕРЕДАЁТ ЗВУК · перезагрузите ПК после установки VB-CABLE"
                               FontSize="9" FontWeight="SemiBold" Foreground="#FF7B8A" TextWrapping="Wrap" />
                </Border>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource MintSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding OutputDeviceName}" Margin="8,0,0,0" FontSize="11.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Text="{Binding OutputHint}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,7,0,0" />
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="MASTER" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Text2Brush}" />
                    <TextBlock Text="{Binding MasterGain, StringFormat={}{0:F0}%}" FontFamily="{StaticResource MonoFont}"
                               FontSize="9.5" Foreground="{StaticResource MintBrush}" HorizontalAlignment="Right" />
                </Grid>
                <Slider Style="{StaticResource FaderSlider}" Value="{Binding MasterGain, Mode=TwoWay}" Margin="0,6,0,2" />
                <controls:VuMeter Height="6" Segments="18" Level="{Binding OutputLevel}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
