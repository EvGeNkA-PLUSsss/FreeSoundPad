<UserControl x:Class="FreeSoundPad.App.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="BookmarkChip" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="16" Height="16" CornerRadius="8" Background="{Binding AccentBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontSize="8" FontWeight="Bold" Foreground="#E6FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="6,0,0,0" FontSize="10.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="130" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel3Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line2Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- browser toolbar -->
        <Border Grid.Row="0" Background="#0A0E15" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="&#xE72B;" Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}" ToolTip="Назад" />
                    <Button Style="{StaticResource NavButton}" Content="&#xE72A;" Command="{Binding GoForwardCommand}"
                            IsEnabled="{Binding CanGoForward}" ToolTip="Вперёд" />
                    <Button Style="{StaticResource NavButton}" Content="&#xE72C;" Command="{Binding ReloadPageCommand}"
                            ToolTip="Обновить" />
                    <Button Style="{StaticResource NavButton}" Content="&#xE80F;" Command="{Binding GoHomeCommand}"
                            ToolTip="Домой" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="6,0">
                    <TextBox x:Name="UrlBox" Style="{StaticResource UrlTextBox}" Padding="0,0,32,0"
                             Text="{Binding BrowserUrl, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnUrlKeyDown" />
                    <TextBlock x:Name="LockGlyph" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,11,0"
                               HorizontalAlignment="Right" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="&#xE734;" Command="{Binding AddCurrentBookmarkCommand}"
                            ToolTip="Добавить страницу в закладки" />
                    <Button Style="{StaticResource NavButton}" Content="&#xE8A7;" Command="{Binding OpenExternalCommand}"
                            ToolTip="Открыть в системном браузере" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- bookmarks -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="12,7,12,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="28" Padding="9,0" Margin="2,0,0,6"
                        VerticalAlignment="Top"
                        Command="{Binding AddCurrentBookmarkCommand}" ToolTip="Добавить текущую страницу">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Закладка" FontSize="10.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ItemsControl ItemsSource="{Binding Bookmarks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BookmarkChip}" Command="{Binding NavigateCommand}">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Открыть" Command="{Binding NavigateCommand}" />
                                        <MenuItem Header="Удалить закладку" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- page -->
        <Grid Grid.Row="2" Background="#07090D">
            <wv2:WebView2 x:Name="Web" />

            <Border Background="{StaticResource BgBrush}" Visibility="{Binding BrowserUnavailable, Converter={StaticResource BoolVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource RedSoftBrush}"
                            BorderBrush="#33FF5C6C" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Встроенный браузер недоступен" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding BrowserCaptureDetail}" Style="{StaticResource SubtleText}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,14" />
                    <TextBlock Text="Установите Microsoft Edge WebView2 Runtime (Evergreen) и перезапустите приложение."
                               Style="{StaticResource SubtleText}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

