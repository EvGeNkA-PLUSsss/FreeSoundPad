<Window x:Class="FreeSoundPad.App.Dialogs.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeSoundPad"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Margin="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1" CornerRadius="16" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                       MouseLeftButtonDown="OnHeaderDrag" />
            <TextBlock x:Name="LabelText" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
            <TextBox x:Name="ValueBox" Style="{StaticResource InputTextBox}" Height="38" FontSize="13" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
