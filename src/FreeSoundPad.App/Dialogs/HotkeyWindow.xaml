<Window x:Class="FreeSoundPad.App.Dialogs.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeSoundPad"
        Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Margin="18" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1" CornerRadius="16" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Горячая клавиша" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                       MouseLeftButtonDown="OnHeaderDrag" />
            <TextBlock Text="Любая клавиша. Esc — отмена, Backspace — снять. Для * + Num 0–9 или / + Num 0–9 нажми * или /, затем цифру. Без модификатора нужно подтвердить Enter."
                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,16" />
            <Border x:Name="CaptureBorder" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource MintBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Height="84">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PreviewText" Text="не назначена" FontFamily="{StaticResource MonoFont}"
                               FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="HintText" Text="нажмите комбинацию" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="WarningText" Foreground="{StaticResource AmberBrush}" FontSize="10.5" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Снять" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnClear" />
                <Button Content="Служебные" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCaptureSpecial" />
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
