<Window x:Class="FreeSoundPad.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeSoundPad — Настройки"
        Width="820" Height="862" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Margin="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line2Brush}"
            BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Background="#0C1119">
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource LineBrush}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock Text="Настройки" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                               MouseLeftButtonDown="OnHeaderDrag" />
                    <TextBlock Text="звук, маршрутизация, захват" Style="{StaticResource SubtleText}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,14,0"
                        Click="OnClose" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,12">
                <StackPanel>
                    <!-- audio devices -->
                    <TextBlock Text="АУДИОУСТРОЙСТВА" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="МИКРОФОН" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="1,0,0,5" />
                            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding CaptureDevices}"
                                      DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMicDevice, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="ВИРТУАЛЬНЫЙ ВЫХОД" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="1,0,0,5" />
                            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding RenderDevices}"
                                      DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="МОНИТОРИНГ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="1,0,0,5" />
                            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding RenderDevices}"
                                      DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="ФОРМАТ / БУФЕР" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Margin="1,0,0,5" />
                            <Border Height="34" CornerRadius="8" Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" Padding="11,0">
                                <TextBlock Text="48 kHz · stereo · 30 мс" FontSize="11.5" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="14,11,14,10" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="ГРОМКОСТЬ МОНИТОРИНГА" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MonitorGain, StringFormat={}{0:F0}%}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MintBrush}" />
                            </Grid>
                            <Slider Style="{StaticResource FaderSlider}" Value="{Binding MonitorGain, Mode=TwoWay}" Margin="0,8,0,2" />
                            <TextBlock Text="Громкость, с которой оверлей и звуки слышны в наушниках мониторинга."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- cable -->
                    <TextBlock Text="ВИРТУАЛЬНЫЙ КАБЕЛЬ" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="15,13,15,14" Margin="0,0,0,18"
                            BorderBrush="{StaticResource MintBorderBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#103FE0B0" Offset="0" />
                                <GradientStop Color="#FF101622" Offset="0.9" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding OutputDeviceName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" CornerRadius="99" Padding="8,3"
                                        Background="{StaticResource MintSoftBrush}" BorderBrush="{StaticResource MintBorderBrush}"
                                        BorderThickness="1" Visibility="{Binding CableDetected, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="НАЙДЕН" FontSize="8" FontWeight="Bold" Foreground="{StaticResource MintBrush}" />
                                </Border>
                                <Border HorizontalAlignment="Right" CornerRadius="99" Padding="8,3"
                                        Background="#1AFFC266" BorderBrush="#44FFC266" BorderThickness="1"
                                        Visibility="{Binding CableDetected, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="НЕ НАЙДЕН" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding CableHint}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <StackPanel Margin="0,11,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource MintSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text2Brush}" Margin="8,1,0,0" TextWrapping="Wrap">
                                        В Discord откройте <Run FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}">Настройки → Голос и видео</Run>.
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource MintSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text2Brush}" Margin="8,1,0,0" TextWrapping="Wrap">
                                        Устройство ввода — <Run FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}">CABLE Output</Run>, шумоподавление выключите.
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource MintSoftBrush}" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text2Brush}" Margin="8,1,0,0" TextWrapping="Wrap">
                                        Нажмите «Тест маршрута» — в Discord должен появиться сигнал.
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestRouteCommand}" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Тест маршрута" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Height="32" Margin="8,0,0,0"
                                        Command="{Binding OpenCableWebsiteCommand}" Content="Скачать VB-CABLE" FontSize="11" />
                                <Button Style="{StaticResource GhostButton}" Height="32" Margin="8,0,0,0"
                                        Command="{Binding RefreshDevicesCommand}" Content="Обновить" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- browser capture -->
                    <TextBlock Text="ЗАХВАТ БРАУЗЕРА" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="13,2,13,2" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Height="48">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Захватывать звук встроенного браузера" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="WASAPI process loopback, только дерево процессов WebView2" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding BrowserCaptureEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="48">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Отправлять звук браузера в микрофон" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="звук сайта смешивается с падами и голосом" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding BrowserSend, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="48">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Слышать браузер локально" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="мониторинг звука сайта в наушниках" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding BrowserMonitor, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- hotkeys -->
                    <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="13,2,13,2" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Height="40">
                                <TextBlock Text="Стоп всё" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="7,3">
                                        <TextBlock Text="{Binding StopAllHotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="10" Margin="8,0,0,0"
                                            Content="изменить" Command="{Binding ChangeCommandHotkeyCommand}" CommandParameter="stopAll" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <TextBlock Text="Микрофон в эфир" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="7,3">
                                        <TextBlock Text="{Binding MicHotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="10" Margin="8,0,0,0"
                                            Content="изменить" Command="{Binding ChangeCommandHotkeyCommand}" CommandParameter="mic" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <TextBlock Text="Отправка браузера" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="7,3">
                                        <TextBlock Text="{Binding BrowserHotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="10" Margin="8,0,0,0"
                                            Content="изменить" Command="{Binding ChangeCommandHotkeyCommand}" CommandParameter="browser" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <TextBlock Text="Мониторинг" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="7,3">
                                        <TextBlock Text="{Binding MonitorHotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="10" Margin="8,0,0,0"
                                            Content="изменить" Command="{Binding ChangeCommandHotkeyCommand}" CommandParameter="monitor" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <TextBlock Text="Оверлей" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="7,3">
                                        <TextBlock Text="{Binding OverlayHotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="10" Margin="8,0,0,0"
                                            Content="изменить" Command="{Binding ChangeCommandHotkeyCommand}" CommandParameter="overlay" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <TextBlock Text="Показать окно" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="7,3">
                                        <TextBlock Text="{Binding ShowWindowHotkeyText}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="24" Padding="8,0" FontSize="10" Margin="8,0,0,0"
                                            Content="изменить" Command="{Binding ChangeCommandHotkeyCommand}" CommandParameter="show" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding HotkeyWarning}" FontSize="10" Foreground="{StaticResource AmberBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,8" />
                        </StackPanel>
                    </Border>

                    <!-- pad bindings -->
                    <TextBlock Text="БИНДЫ ПАДОВ" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="13,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Клавиши на пады" FontSize="11.5" />
                                <TextBlock Text="{Binding PadHotkeysText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Снять все бинды" Style="{StaticResource GhostButton}"
                                    Foreground="{StaticResource RedBrush}" Height="30" Padding="11,0" FontSize="10"
                                    VerticalAlignment="Center" Command="{Binding ClearAllPadHotkeysCommand}" />
                        </Grid>
                    </Border>

                    <!-- system -->
                    <TextBlock Text="СИСТЕМА" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="13,2,13,2" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сворачивать в трей" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="кнопка свёрнуть скрывает окно, приложение работает" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Закрывать в трей" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="крестик окна сворачивает приложение в трей" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="46">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Запускать с Windows" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="автозапуск через HKCU\Run" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- web remote -->
                    <TextBlock Text="ВЕБ-ПУЛЬТ" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="13,12" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Height="40">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Веб-сервер" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="управление падами и настройками с телефона" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding WebServerEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <TextBlock Text="Адрес" FontSize="11.5" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WebServerUrl}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource GhostButton}" Height="26" Padding="8,0" FontSize="10"
                                            Content="Копировать" Command="{Binding CopyWebServerUrlCommand}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource GhostButton}" Height="26" Padding="9,0" FontSize="10"
                                            Content="Открыть" Command="{Binding OpenWebServerCommand}"
                                            IsEnabled="{Binding WebServerEnabled}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Порт" FontSize="11.5" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource InputTextBox}" Width="78" Height="28" Padding="8,0"
                                             Margin="12,0,0,0" TextAlignment="Center"
                                             Text="{Binding WebServerPort, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <TextBlock Text="{Binding WebServerStatus}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource HairLine}" />
                            <Grid Height="40">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Код доступа" FontSize="11.5" />
                                    <TextBlock Text="спросит один раз при открытии с телефона" FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource KeyBadge}" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding WebServerToken}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                   Foreground="{StaticResource MintBrush}" />
                                    </Border>
                                    <Button Style="{StaticResource GhostButton}" Height="26" Padding="9,0" FontSize="10"
                                            Content="Копировать" Command="{Binding CopyWebServerTokenCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Открой адрес с телефона в той же Wi-Fi. Если Windows спросит про сеть — разреши доступ. Сервер работает только в локальной сети."
                                       FontSize="9.5" Foreground="{StaticResource Muted2Brush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- about -->
                    <TextBlock Text="О ПРОГРАММЕ" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                    <Border Style="{StaticResource Card}" Padding="13,12,13,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="FreeSoundPad 0.1 beta" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text=".NET 9 · WPF · WebView2 · NAudio" HorizontalAlignment="Right"
                                           FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource Muted2Brush}" />
                            </Grid>
                            <TextBlock Text="Захват звука браузера: WASAPI process loopback. Виртуальный микрофон требует внешнего кабеля (VB-CABLE, VoiceMeeter)."
                                       FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Height="28" Padding="10,0" FontSize="10"
                                        Command="{Binding OpenSoundsFolderCommand}" Content="Папка библиотеки" />
                                <Button Style="{StaticResource GhostButton}" Height="28" Padding="10,0" FontSize="10" Margin="8,0,0,0"
                                        Command="{Binding OpenRepoCommand}" Content="Папка данных" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- footer -->
            <Border Grid.Row="2" Background="#0C1119" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <TextBlock Text="Изменения применяются сразу и сохраняются автоматически"
                               FontSize="10" Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Закрыть" Margin="0,0,8,0" Click="OnClose" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Готово" Click="OnSave" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
